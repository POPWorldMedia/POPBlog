<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <AssemblyName>PopBlog.Mvc</AssemblyName>
	  <PackageId>PopBlog.Mvc</PackageId>
	  <AssemblyVersion>4.0.0</AssemblyVersion>
	  <VersionPrefix>4.0.0</VersionPrefix>
		<Description>A Razor class library with logic to render a simple blog engine.</Description>
		<Authors>Jeff Putz</Authors>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
	  <PackageProjectUrl>https://github.com/POPWorldMedia/POPBlog</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/POPWorldMedia/POPBlog</RepositoryUrl>
	  <Copyright>2026, POP World Media, LLC</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <StaticWebAssetBasePath>/PopBlog</StaticWebAssetBasePath>
	  <AssignTargetPathsDependsOn>BuildFrontendAssets;$(AssignTargetPathsDependsOn)</AssignTargetPathsDependsOn>
	  <DefineStaticWebAssetsDependsOn>BuildFrontendAssets;$(DefineStaticWebAssetsDependsOn)</DefineStaticWebAssetsDependsOn>
	  <ResolveStaticWebAssetsInputsDependsOn>BuildFrontendAssets;$(ResolveStaticWebAssetsInputsDependsOn)</ResolveStaticWebAssetsInputsDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- Exclude source/build files from NuGet package content -->
  <ItemGroup>
    <Content Remove="package.json" />
    <Content Remove="package-lock.json" />
    <Content Remove="build.js" />
    <Content Remove="Client\**" />
    <None Include="package.json" />
    <None Include="package-lock.json" />
    <None Include="build.js" />
  </ItemGroup>

  <ItemGroup>
    <FrontendAssetInput Include="Client\**" />
    <FrontendAssetInput Include="build.js" />
    <FrontendAssetInput Include="package.json" />
  </ItemGroup>

  <!-- Minifies Client/*.js and *.css into wwwroot/dist and copies vendored node_modules assets
       into wwwroot/lib before static web assets are scanned. Inputs/Outputs make this a no-op
       when nothing relevant changed. -->
  <Target Name="BuildFrontendAssets" Inputs="@(FrontendAssetInput)" Outputs="wwwroot\dist\TinyHelper.min.js">
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="!Exists('$(MSBuildProjectDirectory)/node_modules')" />
    <Exec Command="node build.js" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
