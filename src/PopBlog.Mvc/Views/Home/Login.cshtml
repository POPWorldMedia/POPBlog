@using PopBlog.Mvc
@inject IConfig Config;
@{
	ViewBag.Title = "Login";
	var turnstileKey = Config.TurnstileSiteKey;
}
<h1>Login</h1>

<div asp-validation-summary="All"></div>

<form asp-controller="Home" asp-action="Login">
	<div class="mb-3">
        <label for="email" class="form-label">Email</label>
		<input type="email" id="email" name="email" class="form-control" />
	</div>
	<div class="mb-3">
		<label for="password" class="form-label">Password</label>
		<input type="password" id="password" name="password" class="form-control" />
	</div>
	<div class="cf-turnstile mb-3" data-sitekey="@turnstileKey" data-action="login" data-appearance="interaction-only" data-response-field-name="Token"></div>
	<button type="submit" class="btn btn-primary mb-3">Login</button>
</form>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>